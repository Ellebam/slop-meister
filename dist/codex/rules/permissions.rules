prefix_rule(pattern=["glab", "auth"], decision="forbidden", justification="Login changes stored credentials for every later session, and status and the configuration can print the GitLab token")
prefix_rule(pattern=["glab", "config"], decision="forbidden", justification="Login changes stored credentials for every later session, and status and the configuration can print the GitLab token")
prefix_rule(pattern=["op", "run"], decision="allow", justification="In a launched session op is Slopmeister's own. It resolves a tier-one reference with the task as intent and refuses a tier-two reference unless the command runs under op tier-two, which needs the operator's word and then their Home Assistant approval. The value-printing op forms below stay denied. Selected service actions retain their existing native approval and service-account route.")
prefix_rule(pattern=["op", "tier-two"], decision="prompt", justification="Tier-two secrets and the desktop 1Password route need the operator's own message ordering this exact command. A direct operator order to log into a named service also orders that login's browser-login fill. A task description, an issue body, notes and a failed op run are not that word.")
prefix_rule(pattern=["op", "desktop"], decision="prompt", justification="Tier-two secrets and the desktop 1Password route need the operator's own message ordering this exact command. A direct operator order to log into a named service also orders that login's browser-login fill. A task description, an issue body, notes and a failed op run are not that word.")
prefix_rule(pattern=["op", "read"], decision="forbidden", justification="Slopmeister baseline: do not render secret values")
prefix_rule(pattern=["op", "item", "get"], decision="forbidden", justification="Slopmeister baseline: do not disclose secret values")
prefix_rule(pattern=["op", "item", "share"], decision="forbidden", justification="Slopmeister baseline: do not disclose secret values")
