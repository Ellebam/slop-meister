#!/usr/bin/env python3
"""The one repository entry point. Task targets and absolute-path callers use it."""

from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from slopmeister.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
