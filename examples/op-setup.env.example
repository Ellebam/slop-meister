# Copy outside the checkout to ~/.config/slopmeister/op-setup.env with mode 0600.
# Choose a token vault that no service account can read.
SLOPMEISTER_OP_TIER_ONE=op://agent-tokens/TIER_ONE/credential
SLOPMEISTER_OP_TIER_TWO=op://agent-tokens/TIER_TWO/credential
SLOPMEISTER_OP_TOKEN_VAULT=agent-tokens
