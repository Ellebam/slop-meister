[Unit]
Description=Operator-approved secret workflows
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=slopmeister-secret-ask
Group=slopmeister-secret-ask
SupplementaryGroups={{ secret_ask_agent_user }}
ExecStart={{ secret_ask_root }}/current/.venv/bin/python -I {{ secret_ask_root }}/current/bin/slopmeister secret-ask serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillMode=control-group
UMask=0077
RuntimeDirectory=slopmeister-secret-ask
RuntimeDirectoryMode=0755
StateDirectory=slopmeister-secret-ask
StateDirectoryMode=0700
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitCORE=0
MemoryMax=256M
TasksMax=128

[Install]
WantedBy=multi-user.target
